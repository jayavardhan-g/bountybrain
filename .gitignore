.venv/
venv/
__pycache__/
*.pyc
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.DS_Store
.streamlit/secrets.toml

# Per-machine agent settings. Already covered by a global gitignore on this
# box, but not by the repo's, so a fresh clone would offer it up as a new file.
.claude/settings.local.json

# Downloaded datasets — ~1 GB, rebuild with `python fetch_data.py`.
# Not committed: they are other projects' repositories under their own
# licences, and vendoring them here would be both huge and wrong.
data/raw/

# Derived artefacts — rebuild with `build_graph.py` / `index_corpus.py`.
data/qdrant/
data/corpus/
data/pgdata/
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm

# Graph exports — tens of MB, regenerate with `python export_graph.py`.
# Matched by extension rather than by name: every CSV in here is a graph dump
# running to millions of rows, so whatever the next export adds stays out too.
# The small JSON metrics in artifacts/ *are* committed: they are the evidence
# for the numbers quoted in the README.
artifacts/*.graphml
artifacts/*.csv

# Local run logs and compile caches.
# Triton/Inductor caches must live on a local filesystem — creating them on a
# GlusterFS mount fails with `OSError: [Errno 61] No data available`.
.logs/
.cache/
