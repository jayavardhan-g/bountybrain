.venv/
venv/
__pycache__/
*.pyc
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.DS_Store
.streamlit/secrets.toml

# Downloaded datasets — ~1 GB, rebuild with `python fetch_data.py`.
# Not committed: they are other projects' repositories under their own
# licences, and vendoring them here would be both huge and wrong.
data/raw/

# Derived artefacts — rebuild with `build_graph.py` / `index_corpus.py`.
data/qdrant/
data/corpus/
data/pgdata/
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm

# Local run logs and compile caches.
# Triton/Inductor caches must live on a local filesystem — creating them on a
# GlusterFS mount fails with `OSError: [Errno 61] No data available`.
.logs/
.cache/
