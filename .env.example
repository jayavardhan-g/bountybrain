# --- LLM provider ---
# One of: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_EXTRACTION_MODEL=qwen2.5:7b-instruct
LLM_TUTORIAL_MODEL=llama3.1:8b-instruct

OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=bountybrain_reports

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bountybrain
POSTGRES_USER=bountybrain
POSTGRES_PASSWORD=bountybrain
DATABASE_URL=postgresql+psycopg://bountybrain:bountybrain@localhost:5432/bountybrain

# --- Live web search (Brave, free tier) ---
BRAVE_API_KEY=

# --- Runtime ---
DATA_DIR=./data
CORPUS_CACHE_DIR=./data/reports
RAW_CACHE_DIR=./data/raw
LOG_LEVEL=INFO

# --- Ingestion rate limits ---
FETCH_DELAY_SECONDS=1.5
MAX_REPORTS_PER_SOURCE=250
