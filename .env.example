# --- LLM ---
# vllm (default, local server) | ollama | openai | anthropic
LLM_PROVIDER=vllm
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
LLM_EXTRACTION_MODEL=Qwen/Qwen2.5-14B-Instruct
LLM_TUTORIAL_MODEL=Qwen/Qwen2.5-14B-Instruct

# Local vLLM server (start it with `python serve_llm.py`)
VLLM_BASE_URL=http://localhost:8010/v1
VLLM_API_KEY=EMPTY
LLM_MAX_CONCURRENCY=32
LLM_TIMEOUT_SECONDS=180

# Alternative providers (unused by default)
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# --- Embeddings / rerank ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
EMBED_BATCH_SIZE=256
EMBED_DEVICE=cuda

# --- Vector store ---
# Leave QDRANT_URL empty to run Qdrant embedded against QDRANT_PATH — no
# server, no port binding. Set it to use a standalone Qdrant instead.
QDRANT_URL=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=bountybrain

# --- Knowledge graph store ---
# SQLite by default so the build is reproducible anywhere with no server.
DATABASE_URL=sqlite+pysqlite:///./data/bountybrain.sqlite

# --- Runtime ---
DATA_DIR=./data
CORPUS_CACHE_DIR=./data/corpus
RAW_CACHE_DIR=./data/raw
ARTIFACT_DIR=./artifacts
LOG_LEVEL=INFO
